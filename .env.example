# =============================================================================
# MYVET CABINET VÉTÉRINAIRE — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env for local development. NEVER commit real secrets.
# All server secrets MUST remain server-only (NEVER prefix with VITE_).
# =============================================================================

# Runtime environment: development | production | test
NODE_ENV="development"

# Public application URL
APP_URL="http://localhost:3000"

# Supabase PostgreSQL Connection String (REQUIRED in production)
# Use the Supabase Session/Transaction Pooler URI for serverless deployments.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Secret used to sign HTTP-only staff session cookies (min 32 random chars in production)
SESSION_SECRET="replace-with-a-strong-random-32-plus-char-secret"

# Secret protecting POST /api/cron/process-reminders in production (Bearer token)
CRON_SECRET="replace-with-a-strong-cron-secret"

# Development convenience: automatically signs in Dr. Vétérinaire locally when NODE_ENV != production
# Ignored completely in production.
AUTO_DEV_LOGIN="true"

# Optional local dev polling scheduler (never used in Vercel Serverless)
ENABLE_DEV_SCHEDULER="false"

# SMS Gateway Configuration (Algeria E.164 +213)
# Default: TEST (safe simulation, logs without real billing/dispatch)
SMS_PROVIDER_MODE="TEST"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="MyVet"
SMS_WEBHOOK_SECRET=""

# Optional Gemini AI key (server-side only if AI features are enabled)
GEMINI_API_KEY=""
